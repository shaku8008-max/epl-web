# Copy this file to .env.local and paste in the real values, then restart the
# dev server. .env.local is ignored by git (see .gitignore), so real values
# are never committed. Find both values in the Supabase dashboard under
# Project Settings -> API.

# Project URL, e.g. https://abcdefghij.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public key only: labelled "publishable" (sb_publishable_...) or "anon" in
# the dashboard. Never use the secret/service key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Service key: server-only, used to read/write the private `journal` and
# `results` tables. No NEXT_PUBLIC_ prefix, so it never reaches the browser.
# Labelled "service_role" in the dashboard (a JWT starting with eyJ...).
SUPABASE_SERVICE_KEY=eyJ_your_service_role_key_here

# Refresh trigger: server-only, read by route handlers and
# src/lib/github.ts. No NEXT_PUBLIC_ prefix, so the token never reaches the
# browser. Copy the real values into web/.env.local; placeholders stay here.
# Fine-grained token limited to Actions read and write on this one repository.
GITHUB_TOKEN=ghp_your_token_here
# Repository owner, e.g. shaku8008-max
GITHUB_OWNER=your-github-owner
# Repository name, e.g. epl-predictor
GITHUB_REPO=your-github-repo
# Workflow file name, e.g. predict.yml
GITHUB_WORKFLOW=predict.yml
# Git ref the workflow runs on, e.g. main
GITHUB_REF=main